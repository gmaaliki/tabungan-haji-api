{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Tabungan Haji API",
    "description": "REST API untuk Tabungan Haji Online - BSI. Memakai JWT auth dengan role (USER/ADMIN) dan ownership nasabah-tabungan.\n\nAlur run: Login (User) -> Login (Admin) -> Admin daftarkan & link nasabah ke user -> Admin buka rekening -> User setor/tarik/lihat miliknya. Endpoint admin-only memakai {{admin_token}}, endpoint milik-sendiri memakai {{token}} (user).\n\nPrasyarat: buat satu user lalu promosikan jadi ADMIN di DB (UPDATE users SET role='ADMIN' WHERE email=...), set kredensialnya di variable admin_email/admin_password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "admin_email", "value": "admin@tabungan.test", "type": "string" },
    { "key": "admin_password", "value": "admin123", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "nasabah_id", "value": "", "type": "string" },
    { "key": "tabungan_id", "value": "", "type": "string" },
    { "key": "transaksi_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register (User)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@tabungan.test\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 atau 409\", () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (User)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@tabungan.test\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Punya token\", () => pm.expect(r.data).to.have.property(\"token\"));",
                  "if (r.data && r.data.token) pm.collectionVariables.set(\"token\", r.data.token);",
                  "if (r.data && r.data.user && r.data.user.id) pm.collectionVariables.set(\"user_id\", r.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Role ADMIN\", () => pm.expect(r.data.user.role).to.eql(\"ADMIN\"));",
                  "if (r.data && r.data.token) pm.collectionVariables.set(\"admin_token\", r.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
